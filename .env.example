# Yandex Messenger Time Tracking Bot Configuration

# Required variables
YANDEX_OAUTH_TOKEN=your_oauth_token_here
DATABASE_URL=postgresql+asyncpg://timetracker_bot:password@localhost:5432/timetracker?sslmode=require
ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here
WEBHOOK_URL=https://your-public-domain.com/webhook

# Optional variables
LISTEN_PORT=8443
LOG_LEVEL=INFO